{
  "manifest_version": 3,
  "name": "Phishing Link Check",
  "version": "0.1.0",
  "description": "Warns before you open a link whose hostname looks like phishing. Sends hostnames only.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Phishing Link Check",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://vktjpkafxf.execute-api.ap-southeast-2.amazonaws.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "warning.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
